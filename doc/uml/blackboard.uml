@startuml
title WattleFlow Blackboard Persistance – Class Diagram

  package "blackboard.persistance" {

    class GenericBlackboard{
      - create_strategy: CreateStrategy
      ..
      + register_repository(repository: IRepository)
      ..
      + create(*args, **kwargs) : DocumentFacade
      + read(identifier:str, **kwargs) : DocumentFacade
      + write(document: DocumentFacade) : [uuid]
    }

    class GenericRepository {
      - read_strategy: IStratgy
      - write_strategy: IStratgy
      ..
      + read(identifier:str) : DocumentFacade
      + write(identifier:str, document: DocumentFacade) : str
    }

    class CreateStrategy {
      + create() : DocumentFacade
    }

    class ReadStrategy {
      + read() : DocumentFacade
    }

    class WriteStrategy {
      + write() : DocumentFacade
    }

    class DocumentFacade {
      + update_cotntent()
    }
    
    class DocumentFacade {
    }
  }
  
  GenericBlackboard "1" <--o "read" GenericRepository
  GenericBlackboard "1" o--> "write" GenericRepository
  GenericBlackboard "1" o-- "create" CreateStrategy

  GenericRepository "1" o--> "read" ReadStrategy
  GenericRepository "1" <--o "write" WriteStrategy
  CreateStrategy "1" o--> "create" DocumentFacade

@enduml
