global-exclude *

include src/concrete/**/*.py
include src/constants/**/*.py
include src/decorators/**/*.py
include src/doc/**/*
include src/helpers/**/*.py
include src/managers/**/*.py
include src/mappers/**/*.py
include src/orchestrators/**/*.py
include src/mappers/**/*.py

exclude *.log
exclude *.tmp
exclude *.yaml

prune tests/
prune docs/
prune data/

include README.md LICENSE pyproject.toml
include project.toml
