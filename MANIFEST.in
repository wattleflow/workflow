# Source distribution contents — wattleflow-workflow (stdli) only.
#
# Project builds the wheel FROM this sdist, so pruning here keeps
# third-party-coupled modules out of the wheel as well. Core ships:
#   concrete + constants + decorators (incl. oscal glue) + oscal engine
#   + the import-clean helpers subset.
# Specializations (connections/, drivers/, processors/, pipelines/, documents/,
# strategies/, mappers/, api/, blackboards/, ...) and the third-party-coupled
# helpers move to the separate wattleflow projects / wattleflow-cryptography
# / examples projects (zero-trust packaging).
#
# "import-clean" = importable with only wattleflow-core (stdlib) + wattleflow-workflow + cryptography;
# any third-party use is lazy/optional (try/except fallback or in-function import),
# so installing this wheel never forces a third-party dependency.

global-exclude *
global-exclude .*
global-exclude *.pyc
global-exclude *.json
global-exclude *.yaml
global-exclude __pycache__/*

# --- Clean core packages ---
recursive-include src/wattleflow/concrete *.py
recursive-include src/wattleflow/constants *.py
recursive-include src/wattleflow/decorators *.py
recursive-include src/wattleflow/helpers *.py


# --- Drop third-party-coupled helpers not used by the core (-> wattleflow-processors) ---
recursive-exclude src/wattleflow/helpers/converters *.py
exclude src/wattleflow/helpers/*.bak
exclude src/wattleflow/helpers/image_guard.py
exclude src/wattleflow/helpers/protobuf.py

# --- Never ship the core (ships via the separate project dependency) ---
prune src/wattleflow/core

include README.md LICENSE pyproject.toml requirements-dev.txt
