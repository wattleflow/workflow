# exclude cache
prune __pycache__
prune .pytest_cache

# exclude file types
exclude *.config
exclude *.pyc
exclude *.pyo
exclude *.yaml
exclude .flake8
exclude .pylintrc

# exclude other files
exclude .DS_Store
exclude .dist
exclude .env
exclude .flake8
exclude .github/*
exclude .gitignore
exclude .gitignore
exclude .idea
exclude .pylintrc
exclude .scraps
exclude .vscode
exclude Makefile
exclude examples
exclude todo

# source
exclude src/wattleflow/api
exclude src/wattleflow/audit
exclude src/wattleflow/blackboards
exclude src/wattleflow/connections
exclude src/wattleflow/core
exclude src/wattleflow/documents/rdf.py
exclude src/wattleflow/managers
exclude src/wattleflow/processors
exclude src/wattleflow/repositories
exclude src/wattleflow/schedulers

# exclude other dirs
exclude da*
exclude doc
exclude endpoints
exclude examples
exclude helpers/audit.py
exclude helpers/logger.py
exclude models
exclude scripts
exclude src
exclude tests
exclude tests/config.yaml
exclude tests/scheduler.yaml
exclude tools/doc

# includes
include README.md LICENSE
include doc/wattleflow.png

# recursive
recursive-include src/wattleflow/ *.py
